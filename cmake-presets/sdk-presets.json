      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/aarch64-gcc9.3/bin/aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "/opt/aarch64-gcc9.3/bin/aarch64-linux-gnu-g++"
      },
      "description": "aarch64 交叉编译段：toolchainFile + 交叉编译器覆盖掉 linux-common 里的本地 gcc-9.3。"
    },
    {
      "name": "linux-aarch64-shared",
      "inherits": "linux-aarch64-common",
      "displayName": "Linux aarch64 交叉编译 动态库",
      "description": "对应 shell/buildOXiAll.sh 的 Linux-ARM64 + shared。",
      "cacheVariables": {
        "BUILD_STATIC_LIBS": "OFF"
      }
    },
    {
      "name": "linux-aarch64-static",
      "inherits": "linux-aarch64-shared",
      "displayName": "Linux aarch64 交叉编译 静态库",
      "cacheVariables": {
        "BUILD_STATIC_LIBS": "ON"
      }
    }
  ]
}
